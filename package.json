{
  "name": "no-thanks.js",
  "version": "0.1.5",
  "description": "An ultra-light consent banner: no dependency, no cookie, respects Do Not Track and Global Privacy Control.",
  "keywords": [
    "consent",
    "cookie",
    "banner",
    "gdpr",
    "rgpd",
    "cmp",
    "privacy",
    "do-not-track",
    "gpc"
  ],
  "homepage": "https://corentingautier.dev/no-thanks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corentin-gautier/no-thanks.git"
  },
  "bugs": "https://github.com/corentin-gautier/no-thanks/issues",
  "license": "GPL-3.0-or-later",
  "author": "Corentin Gautier",
  "main": "dist/no-thanks.js",
  "unpkg": "dist/no-thanks.js",
  "jsdelivr": "dist/no-thanks.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node test/run.js && php test/plugin.php",
    "demo": "node scripts/demo.js",
    "i18n": "scripts/i18n.sh",
    "cmp-sizes": "node scripts/cmp-sizes.js",
    "release": "npm run build && npm test && npx --yes standard-version && git push --follow-tags origin main && gh workflow run build -R corentin-gautier/composer-repo"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.55"
  }
}
