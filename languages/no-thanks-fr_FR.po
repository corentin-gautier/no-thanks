"Project-Id-Version: No Thanks 0.1.0\n"
"Language: fr_FR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: no-thanks\n"

msgid "Cookies"
msgstr "Cookies"

msgid "a measurement tool"
msgstr "un outil de mesure"

msgid "measure its audience"
msgstr "mesurer son audience"

msgid "show you advertising"
msgstr "vous montrer de la publicité"

msgid "measure its advertising campaigns"
msgstr "mesurer ses campagnes publicitaires"

msgid "Cookies and trackers"
msgstr "Cookies et traceurs"

msgid "This site would like to {purpose} with {services}. Is that OK?"
msgstr "Ce site aimerait {purpose} avec {services}. Vous êtes d’accord ?"

msgid "Your browser asks not to be tracked: {services} stays off."
msgstr "Votre navigateur demande à ne pas être suivi : {services} reste désactivé."

msgid "Your choice: {choice}, on {date}."
msgstr "Votre choix : {choice}, le {date}."

msgid "accepted"
msgstr "accepté"

msgid "refused"
msgstr "refusé"

msgid "No thanks"
msgstr "Non merci"

msgid "OK"
msgstr "D’accord"

msgid "Allow anyway"
msgstr "L’autoriser quand même"

msgid "Learn more"
msgstr "En savoir plus"

msgid "Settings"
msgstr "Réglages"

msgid "A consent banner for the trackers this site uses. Leave the scripts empty and nothing is loaded."
msgstr "Un bandeau de consentement pour les traceurs du site. Laissez les scripts vides et rien n’est chargé."

msgid "Services"
msgstr "Services"

msgid "Named in the banner, e.g. Google Analytics, Meta Pixel."
msgstr "Nommés dans le bandeau, par exemple Google Analytics, Meta Pixel."

msgid "Purpose"
msgstr "Finalité"

msgid "Completes “This site would like to … with these services”, e.g. %s."
msgstr "Complète « Ce site aimerait … avec ces services », par exemple %s."

msgid "Scripts in the head"
msgstr "Scripts dans le head"

msgid "Scripts at the end of the page"
msgstr "Scripts en fin de page"

msgid "Paste the code as the service gives it. It only runs once the visitor agrees."
msgstr "Collez le code tel que le service le donne. Il ne s’exécute qu’après l’accord du visiteur."

msgid "“Learn more” page"
msgstr "Page « En savoir plus »"

msgid "Privacy policy page (Settings › Privacy)"
msgstr "Page de politique de confidentialité (Réglages › Confidentialité)"

msgid "Footer link"
msgstr "Lien de pied de page"

msgid "Any link to %s reopens the banner, so visitors can change their mind: add one to the footer menu."
msgstr "Tout lien vers %s rouvre le bandeau pour que le visiteur change d’avis : ajoutez-en un au menu du pied de page."
