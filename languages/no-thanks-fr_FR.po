msgid ""
msgstr ""
"Project-Id-Version: No Thanks 0.1.0\n"
"Language: fr_FR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: no-thanks\n"

msgid "A consent banner for the trackers this site uses. Leave the scripts empty and nothing is loaded."
msgstr "Un bandeau de consentement pour les traceurs du site. Laissez les scripts vides et rien n’est chargé."

msgid "Accept button"
msgstr "Bouton d’acceptation"

msgid "Added to the footer by the theme. Any other link to #no-thanks also reopens the banner."
msgstr "Ajouté au pied de page par le thème. Tout autre lien vers #no-thanks rouvre aussi le bandeau."

msgid "Allow anyway"
msgstr "L’autoriser quand même"

msgid "Banner"
msgstr "Bandeau"

msgid "Button to allow anyway"
msgstr "Bouton pour autoriser quand même"

msgid "Cookies"
msgstr "Cookies"

msgid "Cookies allowed"
msgstr "Cookies autorisés"

msgid "Cookies and trackers"
msgstr "Cookies et traceurs"

msgid "Cookies not allowed"
msgstr "Cookies non autorisés"

msgid "Corner button when allowed"
msgstr "Bouton d’angle si autorisé"

msgid "Corner button when not allowed"
msgstr "Bouton d’angle si non autorisé"

msgid "Footer link"
msgstr "Lien de pied de page"

msgid "Learn more"
msgstr "En savoir plus"

msgid "Message"
msgstr "Message"

msgid "Message when the browser asks not to be tracked"
msgstr "Message quand le navigateur demande à ne pas être suivi"

msgid "Name the services and what they are for. Changing it asks every visitor again."
msgstr "Nommez les services et leur usage. Le modifier redemande l’accord de tous les visiteurs."

msgid "No thanks"
msgstr "Non merci"

msgid "OK"
msgstr "D’accord"

msgid "Once the banner is closed, a cookie button in the corner shows the state and reopens it; this text shows on hover."
msgstr "Une fois le bandeau fermé, un bouton cookie dans l’angle montre l’état et le rouvre ; ce texte s’affiche au survol."

msgid "Paste the code as the service gives it. It only runs once the visitor agrees."
msgstr "Collez le code tel que le service le donne. Il ne s’exécute qu’après l’accord du visiteur."

msgid "Refuse button"
msgstr "Bouton de refus"

msgid "Reminder after accepting"
msgstr "Rappel après acceptation"

msgid "Reminder after refusing"
msgstr "Rappel après refus"

msgid "Scripts at the end of the page"
msgstr "Scripts en fin de page"

msgid "Scripts in the head"
msgstr "Scripts dans le head"

msgid "Settings"
msgstr "Réglages"

msgid "Shown when the banner is reopened; {date} is replaced by the date of the choice."
msgstr "Affiché quand le bandeau est rouvert ; {date} est remplacé par la date du choix."

msgid "Such visitors get no tracker: this message shows a few seconds on their first visit, then from the footer link."
msgstr "Ces visiteurs n’ont aucun traceur : ce message s’affiche quelques secondes à leur première visite, puis depuis le lien de pied de page."

msgid "This site would like to measure its audience. Is that OK?"
msgstr "Ce site aimerait mesurer son audience. Vous êtes d’accord ?"

msgid "Title"
msgstr "Titre"

msgid "Trackers"
msgstr "Traceurs"

msgid "You agreed on {date}."
msgstr "Vous avez accepté le {date}."

msgid "You refused on {date}."
msgstr "Vous avez refusé le {date}."

msgid "Your browser asks not to be tracked: noted, no tracker is on."
msgstr "Votre navigateur demande à ne pas être suivi : c’est noté, aucun traceur n’est activé."
